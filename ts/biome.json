{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["**", "!dist", "!node_modules"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } }, "noNonNullAssertion": "error" },
      "suspicious": { "noExplicitAny": "error" }
    }
  }
}
